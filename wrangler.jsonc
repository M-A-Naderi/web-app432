{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app432",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b89d6f51-df6a-4dae-aa9e-4a4fbfd10f42","database_name": "web-app67890" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "08fb06fd1e3f4aa39ebcfd75f0f290ad" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
